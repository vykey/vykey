// Security screen: header, score and stat cards, list of issues. Everything
// is computed locally (vykey_core::audit); no breach service is queried.

import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, Card, Divider, SoftButton, LinkText } from "components.slint";

export struct Issue {
    id: string,
    title: string,
    text: string,
    // 0 = high, 1 = medium, 2 = low
    severity: int,
}

export struct SecurityStats {
    score: int,
    ring: string,
    summary: string,
    audited-at: string,
    weak: int,
    reused: int,
    stale: int,
    with-totp: int,
    total: int,
    logins: int,
    added-month: int,
}

component StatCard inherits Card {
    in property <image> icon;
    in property <color> tone;
    in property <color> tone-bg;
    in property <string> value;
    in property <string> label;

    VerticalLayout {
        padding: 18px;
        alignment: space-between;

        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: root.tone-bg;
                Icon {
                    source: root.icon;
                    width: 16px;
                    height: 16px;
                    colorize: root.tone;
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.value;
                font-size: 30px;
                font-weight: 700;
                color: Theme.text-primary;
            }
            Text {
                text: root.label;
                font-size: 13px;
                color: Theme.text-secondary;
            }
        }
    }
}

export component SecurityMain inherits VerticalLayout {
    in property <SecurityStats> stats;
    in property <[Issue]> issues;
    callback fix(string);

    property <bool> show-all: false;
    property <int> preview: 6;

    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 28px;
    padding-right: 28px;
    spacing: 18px;

    // Header
    VerticalLayout {
        spacing: 2px;
        Text {
            text: @tr("Security");
            font-size: 22px;
            font-weight: 700;
            color: Theme.text-primary;
        }
        Text {
            text: root.stats.audited-at;
            font-size: 13px;
            color: Theme.text-tertiary;
        }
    }

    // Score and stat cards
    GridLayout {
        vertical-stretch: 1;
        spacing: 14px;

        Row {
            // Score
            Card {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;

                HorizontalLayout {
                    padding: 20px;
                    spacing: 20px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 120px;
                            height: 120px;

                            // Score track
                            Path {
                                width: 120px;
                                height: 120px;
                                viewbox-width: 120;
                                viewbox-height: 120;
                                commands: "M 60 8 A 52 52 0 1 1 59.99 8";
                                stroke: Theme.border-subtle;
                                stroke-width: 10px;
                            }
                            // Score arc
                            Path {
                                width: 120px;
                                height: 120px;
                                viewbox-width: 120;
                                viewbox-height: 120;
                                commands: root.stats.ring;
                                stroke: Theme.accent;
                                stroke-width: 10px;
                                stroke-line-cap: round;
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: root.stats.score;
                                    horizontal-alignment: center;
                                    font-size: 34px;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }
                                Text {
                                    text: @tr("of 100");
                                    horizontal-alignment: center;
                                    font-size: 11px;
                                    color: Theme.text-tertiary;
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: @tr("Security score");
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        Text {
                            text: root.stats.summary;
                            wrap: word-wrap;
                            font-size: 12px;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }

            // Weak passwords
            StatCard {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;
                icon: Icons.warning;
                tone: Theme.danger;
                tone-bg: #F2555A1F;
                value: root.stats.weak;
                label: @tr("security stat" => "Weak password" | "Weak passwords" % root.stats.weak);
            }

            // Reused passwords
            StatCard {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;
                icon: Icons.clone;
                tone: Theme.warning;
                tone-bg: #FFB2241F;
                value: root.stats.reused;
                label: @tr("Reused");
            }
        }

        Row {
            // Two-factor coverage
            Card {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;

                VerticalLayout {
                    padding: 18px;
                    alignment: space-between;

                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: #3DD68C1F;
                            Icon {
                                source: Icons.mobile;
                                width: 16px;
                                height: 16px;
                                colorize: Theme.success;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: @tr("{0} of {1}", root.stats.with-totp, root.stats.logins);
                            font-size: 26px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        // Coverage bar
                        Rectangle {
                            height: 5px;
                            border-radius: 3px;
                            background: Theme.bg-hover;
                            Rectangle {
                                x: 0;
                                width: root.stats.logins == 0 ? 0 : parent.width * root.stats.with-totp / root.stats.logins;
                                border-radius: 3px;
                                background: Theme.success;
                            }
                        }
                        Text {
                            text: @tr("Two-factor coverage");
                            font-size: 13px;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }

            StatCard {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;
                icon: Icons.stale;
                tone: Theme.text-secondary;
                tone-bg: Theme.bg-hover;
                value: root.stats.stale;
                label: @tr("Unchanged for over a year");
            }

            // Vault size with monthly delta.
            Card {
                height: 190px;
                horizontal-stretch: 1;
                min-width: 160px;
                preferred-width: 160px;

                VerticalLayout {
                    padding: 18px;
                    alignment: space-between;

                    HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: Theme.accent-soft;
                            Icon {
                                source: Icons.vault;
                                width: 16px;
                                height: 16px;
                                colorize: Theme.accent;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: root.stats.total;
                                font-size: 30px;
                                font-weight: 700;
                                color: Theme.text-primary;
                            }
                            if root.stats.added-month > 0: Text {
                                text: @tr("+{0} this month", root.stats.added-month);
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.success;
                                vertical-alignment: bottom;
                            }
                        }
                        Text {
                            text: @tr("Item in the vault" | "Items in the vault" % root.stats.total);
                            font-size: 13px;
                            color: Theme.text-secondary;
                        }
                    }
                }
            }
        }

        Row {
            // Issues
            Card {
                colspan: 3;
                vertical-stretch: 1;

                VerticalLayout {
                    padding-top: 8px;
                    padding-bottom: 8px;
                    padding-left: 20px;
                    padding-right: 20px;

                    // Issues header
                    HorizontalLayout {
                        padding-top: 10px;
                        padding-bottom: 8px;
                        Text {
                            horizontal-stretch: 1;
                            text: @tr("Needs attention");
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text-primary;
                        }
                        if root.issues.length > root.preview: LinkText {
                            text: root.show-all ? @tr("Collapse") : @tr("All {0}", root.issues.length);
                            clicked => { root.show-all = !root.show-all; }
                        }
                    }

                    if root.issues.length == 0: HorizontalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        Icon {
                            source: Icons.circle-check;
                            size: 16px;
                            colorize: Theme.success;
                        }
                        Text {
                            text: root.stats.total == 0 ? @tr("Add items to audit your vault") : @tr("No issues found");
                            font-size: 13px;
                            color: Theme.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    if root.issues.length > 0: ListView {
                        vertical-stretch: 1;
                        for issue[i] in root.issues: VerticalLayout {
                            if (root.show-all || i < root.preview) && i > 0: Divider { }
                            // Issue row
                            if root.show-all || i < root.preview: HorizontalLayout {
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 12px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: issue.severity == 0 ? Theme.danger : issue.severity == 1 ? Theme.warning : Theme.text-tertiary;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    Text {
                                        text: issue.title;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: Theme.text-primary;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: issue.text;
                                        font-size: 12px;
                                        color: Theme.text-secondary;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    SoftButton {
                                        text: @tr("Fix");
                                        clicked => { root.fix(issue.id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
